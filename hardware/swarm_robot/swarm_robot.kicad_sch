	(text "ESP32-S3 BOARD" (exclude_from_sim no) (at 20.32 20.32 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid "b47e4cf7-c713-4ede-b2b9-6f67aabe39e2"))
	(text "Pins left unused on purpose (marked with X):\nGPIO35, 36, 37  - used inside the N16R8 module by the PSRAM\nGPIO0, 3, 45, 46 - strapping pins (decide boot mode)\nGPIO19, 20       - USB\nGPIO43, 44       - serial TX/RX (flashing and logs)\nGPIO48           - on-board RGB LED on most boards\nGPIO38-41, 47    - free spares" (exclude_from_sim no) (at 20.32 27.94 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "697f6554-ffcc-4c48-9f44-956944674069"))
	(text "+5V comes from the buck converter U3 (bottom of the sheet).\n+3V3 is an OUTPUT of the board's own regulator: it powers the line sensor only." (exclude_from_sim no) (at 20.32 50.8 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8ffdc16a-7ad1-4712-a5dd-e361bbd1fe3e"))
	(text "POWER" (exclude_from_sim no) (at 20.32 139.7 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid "5977175b-7807-41a0-b27c-53823aa52ab6"))
